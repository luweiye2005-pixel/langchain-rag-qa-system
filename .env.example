# ===== Database =====
# 本地开发：SQLite；Docker 会覆盖为 PostgreSQL URL
DATABASE_URL=sqlite+aiosqlite:///./rag.db
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb

# ===== LLM (通义千问) =====
# 填入阿里云百炼 API Key
OPENAI_API_KEY=sk-your-qwen-api-key
TONGYI_MODEL=qwen-max

# ===== Voice (DashScope ASR / CosyVoice TTS) =====
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longxiaochun_v3

# ===== Embedding (Ollama) =====
EMBEDDING_MODEL=bge-m3
OLLAMA_BASE_URL=http://localhost:11434

# ===== JWT =====
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0
REDIS_BROKER_URL=redis://localhost:6379/1

# ===== Storage / CORS =====
CHROMA_PERSIST_DIR=./chroma_data
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
VITE_API_BASE_URL=/api/v1

# ===== Initial admin (首次启动时可选创建；请使用强密码) =====
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ===== Upload =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ===== Features =====
ENABLE_HYBRID_SEARCH=false
ENABLE_RERANKING=false

# ===== Rate Limit =====
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_MINUTE=5

# ===== Logging =====
LOG_LEVEL=INFO
